left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1400" height="35" as="geometry"/></mxCell><mxCell id="p3_view_quota_b2" value="&lt;b&gt;Color Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;■ Blue&lt;/font&gt;: Angular Component / Service &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7E22CE&quot;&gt;■ Purple&lt;/font&gt;: PHP REST Endpoint &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#D97706&quot;&gt;■ Amber Cylinder&lt;/font&gt;: MySQL Query / Table &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#CA8A04&quot;&gt;◆ Yellow Diamond&lt;/font&gt;: Decision / Validation&lt;br&gt;&lt;font color=&quot;#16A34A&quot;&gt;■ Green&lt;/font&gt;: &lt;b&gt;SUCCESS Case (200 OK / State Updated)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#DC2626&quot;&gt;■ Red&lt;/font&gt;: &lt;b&gt;FAILED / ERROR Case (400 / 401 / 402 / 403 / 404 / 422)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#EA580C&quot;&gt;■ Orange&lt;/font&gt;: Fallback / Guard Redirect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1080" height="52" as="geometry"/></mxCell><mxCell id="p3_view_quota_b3" value="&lt;b&gt;User Clicks Property Card&lt;/b&gt;&lt;br&gt;Navigates to &lt;code&gt;/property/:id&lt;/code&gt; (PropertyDetailsPageComponent)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="720" y="125" width="340" height="52" as="geometry"/></mxCell><mxCell id="p3_view_quota_b4" value="&lt;b&gt;Pre-Flight Entitlement Check&lt;/b&gt;&lt;br&gt;&lt;code&gt;GET /api/properties/check-limit.php?id=&amp;lt;id&amp;gt;&amp;amp;userId=&amp;lt;uid&amp;gt;&amp;amp;deviceHash=&amp;lt;hash&amp;gt;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="680" y="205" width="420" height="54" as="geometry"/></mxCell><mxCell id="p3_view_quota_b5" value="&lt;b&gt;MySQL: Verify Project Exists&lt;/b&gt;&lt;br&gt;&lt;code&gt;SELECT project_id, project_name, price_from... FROM projects WHERE project_id = ?&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="680" y="285" width="420" height="58" as="geometry"/></mxCell><mxCell id="p3_view_quota_b6" value="Project&lt;br&gt;found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="825" y="370" width="130" height="68" as="geometry"/></mxCell><mxCell id="p3_view_quota_b7" value="&lt;b&gt;FAILED (HTTP 404)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Property dossier not found in registry&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="376" width="310" height="56" as="geometry"/></mxCell><mxCell id="p3_view_quota_b8" value="Is user logged in&lt;br&gt;(userId &amp;gt; 0)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="815" y="470" width="150" height="74" as="geometry"/></mxCell><mxCell id="p3_view_quota_b9" value="Guest views in&lt;br&gt;&lt;code&gt;guest_device_views&lt;/code&gt;&lt;br&gt;(IP or deviceHash)&lt;br&gt;&amp;lt; 2 or already viewed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="575" width="190" height="96" as="geometry"/></mxCell><mxCell id="p3_view_quota_b10" value="&lt;b&gt;GUEST QUOTA EXCEEDED (limitReached = true, canDownload = false)&lt;/b&gt;&lt;br&gt;• Returns masked &lt;code&gt;basicProperty&lt;/code&gt; only (no cadastral/legal details)&lt;br&gt;• Message: &lt;i&gt;&quot;You have reached your free limit of 2 project views. Sign in or upgrade...&quot;&lt;/i&gt;&lt;br&gt;• Frontend displays Masked Dossier + opens OTP Sign-In / Membership Paywall" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="440" height="96" as="geometry"/></mxCell><mxCell id="p3_view_quota_b11" value="&lt;b&gt;GUEST VIEW ALLOWED (canDownload = true)&lt;/b&gt;&lt;br&gt;Records IP + deviceHash + property_id in &lt;code&gt;guest_device_views&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="738" width="300" height="74" as="geometry"/></mxCell><mxCell id="p3_view_quota_b12" value="User role is&lt;br&gt;Admin / Staff /&lt;br&gt;Developer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="580" width="160" height="84" as="geometry"/></mxCell><mxCell id="p3_view_quota_b13" value="&lt;b&gt;STAFF BYPASS (canDownload = true)&lt;/b&gt;&lt;br&gt;&lt;code&gt;activePlanId = 'vip_concierge'&lt;/code&gt; · Limit = 999,999" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1520" y="588" width="310" height="68" as="geometry"/></mxCell><mxCell id="p3_view_quota_b14" value="&lt;b&gt;MySQL: Check Buyer Entitlements &amp;amp; History&lt;/b&gt;&lt;br&gt;1. Fetch/Init &lt;code&gt;user_entitlements&lt;/code&gt; (Explorer=2, Smart=5, Priority=25, VIP=50)&lt;br&gt;2. Check &lt;code&gt;SELECT id FROM user_project_views WHERE user_id=? AND property_id=?&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1120" y="705" width="420" height="78" as="geometry"/></mxCell><mxCell id="p3_view_quota_b15" value="Already unlocked in&lt;br&gt;&lt;code&gt;user_project_views&lt;/code&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1245" y="815" width="170" height="76" as="geometry"/></mxCell><mxCell id="p3_view_quota_b16" value="&lt;b&gt;ALLOWED (Already Unlocked)&lt;/b&gt;&lt;br&gt;&lt;code&gt;canDownload = true&lt;/code&gt; · &lt;b&gt;0 quota deducted&lt;/b&gt; on repeat visits" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1520" y="820" width="320" height="64" as="geometry"/></mxCell><mxCell id="p3_view_quota_b17" value="project_views_used&lt;br&gt;&amp;lt; project_view_limit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1245" y="930" width="170" height="76" as="geometry"/></mxCell><mxCell id="p3_view_quota_b18" value="&lt;b&gt;BUYER PLAN LIMIT REACHED (canDownload = false, limitReached = true)&lt;/b&gt;&lt;br&gt;• Returns masked &lt;code&gt;basicProperty&lt;/code&gt; only&lt;br&gt;• Message: &lt;i&gt;&quot;You have reached your limit of X project views on &amp;lt;Plan&amp;gt;. Upgrade to view full specifications...&quot;&lt;/i&gt;&lt;br&gt;• Frontend renders Upgrade Paywall CTA → &lt;code&gt;/subscription&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1520" y="930" width="460" height="96" as="geometry"/></mxCell><mxCell id="p3_view_quota_b19" value="&lt;b&gt;FULL DOSSIER DOWNLOAD (GET /api/properties/details.php?id=&amp;lt;id&amp;gt;)&lt;/b&gt;&lt;br&gt;• Queries &lt;code&gt;projects&lt;/code&gt; + &lt;code&gt;project_details&lt;/code&gt; + &lt;code&gt;property_master_details&lt;/code&gt; + &lt;code&gt;property_media&lt;/code&gt; + &lt;code&gt;property_subdivided_plots&lt;/code&gt;&lt;br&gt;• Consumes 1 view entitlement (`POST /api/subscriptions/consume-entitlement.php`) &amp;amp; logs in `user_project_views` + `user_view_history`&lt;br&gt;• Renders Full Cadastral Audit, Interactive SVG Plot Layout, Legal Approvals, Connectivity &amp;amp; Brochure" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="1110" width="620" height="100" as="geometry"/></mxCell><mxCell id="p3_view_quota_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_view_quota_b3" target="p3_view_quota_b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_view_quota_e