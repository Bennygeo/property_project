<mxfile host="app.diagrams.net" agent="Antigravity" version="24.7.0"><diagram id="p1_user_auth" name="1. User OTP Login &amp; Logout Flow"><mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_user_auth_b1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Flow 1: Buyer Mobile OTP Login, Session Continuity &amp;amp; Clean Logout (All Success &amp;amp; Failure Cases)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1300" height="35" as="geometry"/></mxCell><mxCell id="p1_user_auth_b2" value="&lt;b&gt;Color Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;■ Blue&lt;/font&gt;: Angular Component / Service &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7E22CE&quot;&gt;■ Purple&lt;/font&gt;: PHP REST Endpoint &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#D97706&quot;&gt;■ Amber Cylinder&lt;/font&gt;: MySQL Query / Table &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#CA8A04&quot;&gt;◆ Yellow Diamond&lt;/font&gt;: Decision / Validation&lt;br&gt;&lt;font color=&quot;#16A34A&quot;&gt;■ Green&lt;/font&gt;: &lt;b&gt;SUCCESS Case (200 OK / State Updated)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#DC2626&quot;&gt;■ Red&lt;/font&gt;: &lt;b&gt;FAILED / ERROR Case (400 / 401 / 402 / 403 / 404 / 422)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#EA580C&quot;&gt;■ Orange&lt;/font&gt;: Fallback / Guard Redirect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1080" height="52" as="geometry"/></mxCell><mxCell id="p1_user_auth_b3" value="1A &amp; 1B. Mobile OTP Request (send-otp.php)  →  OTP Verification &amp; Registration (verify-otp.php)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="1120" height="34" as="geometry"/></mxCell><mxCell id="p1_user_auth_b4" value="&lt;b&gt;User Action&lt;/b&gt;&lt;br&gt;Clicks 'Sign In' in Header OR clicks ♥ Shortlist / restricted action while logged out" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="175" width="280" height="54" as="geometry"/></mxCell><mxCell id="p1_user_auth_b5" value="&lt;b&gt;Frontend: AuthService.openOtpModal()&lt;/b&gt;&lt;br&gt;Opens OTP Modal · User enters Mobile Number · Clicks 'Get OTP'&lt;br&gt;Calls &lt;code&gt;authService.sendOtp(phone)&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="255" width="280" height="62" as="geometry"/></mxCell><mxCell id="p1_user_auth_b6" value="&lt;b&gt;Backend: POST /api/auth/send-otp.php&lt;/b&gt;&lt;br&gt;Reads JSON &lt;code&gt;{ phone }&lt;/code&gt;, strips spaces/hyphens" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="345" width="280" height="52" as="geometry"/></mxCell><mxCell id="p1_user_auth_b7" value="Is phone&lt;br&gt;empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="425" width="130" height="70" as="geometry"/></mxCell><mxCell id="p1_user_auth_b8" value="&lt;b&gt;FAILED (HTTP 422)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Mobile number is required to receive OTP&quot;&lt;/code&gt;&lt;br&gt;UI shows validation error in modal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="432" width="290" height="56" as="geometry"/></mxCell><mxCell id="p1_user_auth_b9" value="Digits &amp;lt; 10?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="525" width="130" height="70" as="geometry"/></mxCell><mxCell id="p1_user_auth_b10" value="&lt;b&gt;FAILED (HTTP 422)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Please enter a valid 10-digit mobile number&quot;&lt;/code&gt;&lt;br&gt;User stays on phone input step" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="532" width="290" height="56" as="geometry"/></mxCell><mxCell id="p1_user_auth_b11" value="&lt;b&gt;Network / Server Unreachable Fallback&lt;/b&gt;&lt;br&gt;&lt;code&gt;catchError()&lt;/code&gt; in AuthService sets &lt;code&gt;lastSentOtp='1111'&lt;/code&gt;, &lt;code&gt;pendingPhone=phone&lt;/code&gt; so offline testing works" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="670" y="340" width="320" height="62" as="geometry"/></mxCell><mxCell id="p1_user_auth_b12" value="&lt;b&gt;SUCCESS (HTTP 200) – OTP Generated&lt;/b&gt;&lt;br&gt;Returns &lt;code&gt;{ phone, dummyOtp: '1111', expiresIn: 300 }&lt;/code&gt;&lt;br&gt;Frontend sets &lt;code&gt;lastSentOtp('1111')&lt;/code&gt;, switches modal to 4-digit OTP view" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="625" width="320" height="64" as="geometry"/></mxCell><mxCell id="p1_user_auth_b13" value="&lt;b&gt;User Enters 4-Digit OTP&lt;/b&gt; (+ optional Name)&lt;br&gt;Clicks 'Verify &amp;amp; Proceed' → &lt;code&gt;authService.verifyOtp(phone, otp, name)&lt;/code&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="300" y="715" width="320" height="54" as="geometry"/></mxCell><mxCell id="p1_user_auth_b14" value="&lt;b&gt;Backend: POST /api/auth/verify-otp.php&lt;/b&gt;&lt;br&gt;Receives &lt;code&gt;{ phone, otp, name, email }&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="795" width="320" height="48" as="geometry"/></mxCell><mxCell id="p1_user_auth_b15" value="phone or otp&lt;br&gt;empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="870" width="130" height="70" as="geometry"/></mxCell><mxCell id="p1_user_auth_b16" value="&lt;b&gt;FAILED (HTTP 422)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Mobile number / OTP verification code is required&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="877" width="290" height="56" as="geometry"/></mxCell><mxCell id="p1_user_auth_b17" value="Is otp ===&lt;br&gt;'1111'?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="970" width="130" height="70" as="geometry"/></mxCell><mxCell id="p1_user_auth_b18" value="&lt;b&gt;FAILED (HTTP 400) – Wrong OTP&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Invalid verification code. Please enter 1111&quot;&lt;/code&gt;&lt;br&gt;AuthService returns &lt;code&gt;{ success: false }&lt;/code&gt; · Modal stays open for retry" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="972" width="295" height="66" as="geometry"/></mxCell><mxCell id="p1_user_auth_b19" value="&lt;b&gt;MySQL: Lookup User by Phone&lt;/b&gt;&lt;br&gt;&lt;code&gt;SELECT * FROM users WHERE phone LIKE '%last10' LIMIT 1&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="1070" width="300" height="62" as="geometry"/></mxCell><mxCell id="p1_user_auth_b20" value="User row&lt;br&gt;exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="1160" width="130" height="70" as="geometry"/></mxCell><mxCell id="p1_user_auth_b21" value="&lt;b&gt;NEW USER REGISTRATION (First-Time Visitor)&lt;/b&gt;&lt;br&gt;1. &lt;code&gt;INSERT INTO users&lt;/code&gt; (role=&lt;code&gt;'buyer'&lt;/code&gt;, points_balance=&lt;code&gt;40&lt;/code&gt;, permissions=DEFAULT_USER_PERMISSIONS)&lt;br&gt;2. &lt;code&gt;INSERT INTO wallet_transactions&lt;/code&gt; (&lt;code&gt;'bonus_credit'&lt;/code&gt;, +40 Welcome Bonus Points)&lt;br&gt;3. &lt;b&gt;0 shortlisted properties&lt;/b&gt; in &lt;code&gt;user_shortlists&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1255" width="360" height="90" as="geometry"/></mxCell><mxCell id="p1_user_auth_b22" value="&lt;b&gt;EXISTING USER LOGIN&lt;/b&gt;&lt;br&gt;If &lt;code&gt;role='buyer'&lt;/code&gt; and permissions empty:&lt;br&gt;&lt;code&gt;UPDATE users SET permissions = defaultBuyerPermissions&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="1255" width="320" height="80" as="geometry"/></mxCell><mxCell id="p1_user_auth_b23" value="Is phone&lt;br&gt;9486140936?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="1375" width="130" height="70" as="geometry"/></mxCell><mxCell id="p1_user_auth_b24" value="&lt;b&gt;Admin Phone Promotion&lt;/b&gt;&lt;br&gt;&lt;code&gt;UPDATE users SET role='admin', developer_id=1, points_balance=10000&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="610" y="1380" width="290" height="58" as="geometry"/></mxCell><mxCell id="p1_user_auth_b25" value="&lt;b&gt;LOGIN SUCCESS (HTTP 200)&lt;/b&gt;&lt;br&gt;• Backend generates &lt;code&gt;token = 'findaplot_token_' + hex&lt;/code&gt; &amp;amp; returns &lt;code&gt;{ user, token }&lt;/code&gt;&lt;br&gt;• &lt;code&gt;authService.setCurrentUser(user)&lt;/code&gt; updates &lt;code&gt;currentUser&lt;/code&gt; signal&lt;br&gt;• Saves user JSON to &lt;code&gt;localStorage['findaplot_auth_user']&lt;/code&gt;&lt;br&gt;• Clears guest views · Closes OTP Modal · Shows green toast &lt;i&gt;&quot;Welcome, &amp;lt;name&amp;gt;!&quot;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="1480" width="400" height="105" as="geometry"/></mxCell><mxCell id="p1_user_auth_e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b4" target="p1_user_auth_b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e27" value="POST JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b5" target="p1_user_auth_b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e28" value="HTTP error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b5" target="p1_user_auth_b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e29" value="fallback OTP=1111" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b11" target="p1_user_auth_b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b6" target="p1_user_auth_b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e31" value="YES (Empty)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b7" target="p1_user_auth_b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e32" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b7" target="p1_user_auth_b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e33" value="YES (&lt;10 digits)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b9" target="p1_user_auth_b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e34" value="NO (Valid 10+ digits)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b9" target="p1_user_auth_b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b12" target="p1_user_auth_b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e36" value="POST JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b13" target="p1_user_auth_b14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b14" target="p1_user_auth_b15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e38" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b15" target="p1_user_auth_b16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e39" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b15" target="p1_user_auth_b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e40" value="NO (otp != 1111)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b17" target="p1_user_auth_b18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e41" value="YES (otp == 1111)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b17" target="p1_user_auth_b19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=