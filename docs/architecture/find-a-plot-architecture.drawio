e="1" parent="1" source="p1_user_auth_b22" target="p1_user_auth_b23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e47" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b23" target="p1_user_auth_b24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e48" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b23" target="p1_user_auth_b25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b24" target="p1_user_auth_b25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_b50" value="1C. Session Continuity Check (Mobile-Prefixed Storage)   &amp;   1D. Manual Logout (No Guest Fallback)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="1060" height="34" as="geometry"/></mxCell><mxCell id="p1_user_auth_b51" value="&lt;b&gt;Reactive Session Watcher (PropertyService)&lt;/b&gt;&lt;br&gt;Angular &lt;code&gt;effect()&lt;/code&gt; triggers &lt;code&gt;handleSessionChange(authService.currentUser())&lt;/code&gt;&lt;br&gt;Purges legacy shared keys (&lt;code&gt;fap_user_shortlists&lt;/code&gt;, etc.)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1480" y="175" width="420" height="64" as="geometry"/></mxCell><mxCell id="p1_user_auth_b52" value="Is user logged in&lt;br&gt;(user.id &amp;gt; 0)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1615" y="270" width="150" height="74" as="geometry"/></mxCell><mxCell id="p1_user_auth_b53" value="&lt;b&gt;Unauthenticated / Logged-Out State&lt;/b&gt;&lt;br&gt;Calls &lt;code&gt;clearShortlistsOnLogout()&lt;/code&gt;:&lt;br&gt;• &lt;code&gt;shortlistedPropertyIds.set(new Set())&lt;/code&gt; (Count = 0)&lt;br&gt;• &lt;code&gt;shortlistedProperties.set([])&lt;/code&gt;&lt;br&gt;• Removes &lt;code&gt;fap_active_session_phone&lt;/code&gt; &amp;amp; &lt;code&gt;fap_guest_*&lt;/code&gt;&lt;br&gt;• &lt;b&gt;NO fallback to User ID 1 / Guest Investor&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1190" y="375" width="360" height="110" as="geometry"/></mxCell><mxCell id="p1_user_auth_b54" value="&lt;b&gt;Compare Session Mobile Prefix&lt;/b&gt;&lt;br&gt;&lt;code&gt;currentPhone = getPhoneStoragePrefix(user.phone)&lt;/code&gt; (last 10 digits)&lt;br&gt;&lt;code&gt;lastSessionPhone = localStorage.getItem('fap_active_session_phone')&lt;/code&gt;&lt;br&gt;Sets &lt;code&gt;localStorage['fap_active_session_phone'] = currentPhone&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1620" y="375" width="420" height="78" as="geometry"/></mxCell><mxCell id="p1_user_auth_b55" value="lastSessionPhone&lt;br&gt;=== currentPhone?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1755" y="485" width="150" height="74" as="geometry"/></mxCell><mxCell id="p1_user_auth_b56" value="&lt;b&gt;NEW / DIFFERENT PHONE SESSION&lt;/b&gt;&lt;br&gt;• Does NOT inherit previous user's memory&lt;br&gt;• Loads only &lt;code&gt;fap_&amp;lt;currentPhone&amp;gt;_shortlists&lt;/code&gt;&lt;br&gt;• Calls &lt;code&gt;fetchShortlistsFromBackend(user.id, { allowLocalSync: false })&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1380" y="595" width="380" height="82" as="geometry"/></mxCell><mxCell id="p1_user_auth_b57" value="&lt;b&gt;SAME PHONE SESSION CONTINUES&lt;/b&gt;&lt;br&gt;• Retains &lt;code&gt;fap_&amp;lt;currentPhone&amp;gt;_shortlists&lt;/code&gt;&lt;br&gt;• Calls &lt;code&gt;fetchShortlistsFromBackend(user.id, { allowLocalSync: true })&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1830" y="595" width="380" height="82" as="geometry"/></mxCell><mxCell id="p1_user_auth_b58" value="&lt;b&gt;GET /api/properties/shortlist.php?userId=&amp;lt;id&amp;gt;&lt;/b&gt;&lt;br&gt;Queries &lt;code&gt;user_shortlists LEFT JOIN properties, projects WHERE user_id = ?&lt;/code&gt;&lt;br&gt;Overwrites &lt;code&gt;fap_&amp;lt;currentPhone&amp;gt;_shortlists&lt;/code&gt; &amp;amp; &lt;code&gt;_shortlist_dossiers&lt;/code&gt; with MySQL ground truth" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1520" y="715" width="480" height="74" as="geometry"/></mxCell><mxCell id="p1_user_auth_e59" value="currentUser signal emits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b25" target="p1_user_auth_b51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="1532"/><mxPoint x="1150" y="207"/></Array></mxGeometry></mxCell><mxCell id="p1_user_auth_e60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b51" target="p1_user_auth_b52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e61" value="NO (null / 0)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b52" target="p1_user_auth_b53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e62" value="YES (user.id &gt; 0)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b52" target="p1_user_auth_b54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b54" target="p1_user_auth_b55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e64" value="NO (Different Phone)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b55" target="p1_user_auth_b56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e65" value="YES (Same Phone)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b55" target="p1_user_auth_b57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b56" target="p1_user_auth_b58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b57" target="p1_user_auth_b58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_b68" value="1D. Manual Sign-Out Flow &amp; Unauthenticated Route / API Guards" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1180" y="830" width="1060" height="34" as="geometry"/></mxCell><mxCell id="p1_user_auth_b69" value="&lt;b&gt;User Clicks 'Sign Out'&lt;/b&gt;&lt;br&gt;(Header Dropdown, Mobile Drawer, or Profile Page)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1220" y="890" width="310" height="54" as="geometry"/></mxCell><mxCell id="p1_user_auth_b70" value="&lt;b&gt;1. AuthService.logout()&lt;/b&gt;&lt;br&gt;• &lt;code&gt;currentUser.set(null)&lt;/code&gt;  (&lt;code&gt;isLoggedIn() === false&lt;/code&gt;)&lt;br&gt;• Removes &lt;code&gt;findaplot_auth_user&lt;/code&gt;, &lt;code&gt;fap_active_session_phone&lt;/code&gt;,&lt;br&gt;  &lt;code&gt;findaplot_admin_session&lt;/code&gt;, &lt;code&gt;findaplot_admin_persona&lt;/code&gt;&lt;br&gt;• Calls &lt;code&gt;clearGuestViews()&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1200" y="975" width="350" height="100" as="geometry"/></mxCell><mxCell id="p1_user_auth_b71" value="&lt;b&gt;2. PropertyService.clearShortlistsOnLogout()&lt;/b&gt;&lt;br&gt;• &lt;code&gt;shortlistedPropertyIds.set(new Set())&lt;/code&gt; → Header badge = 0&lt;br&gt;• &lt;code&gt;shortlistedProperties.set([])&lt;/code&gt;&lt;br&gt;• Updates all property cards &lt;code&gt;isShortlisted = false&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1200" y="1105" width="350" height="90" as="geometry"/></mxCell><mxCell id="p1_user_auth_b72" value="&lt;b&gt;SIGNED OUT CLEANLY&lt;/b&gt;&lt;br&gt;• Navigates to &lt;code&gt;/&lt;/code&gt; (Home)&lt;br&gt;• Shows toast &lt;i&gt;&quot;You have been safely signed out&quot;&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Zero guest auto-login · Zero residual shortlists&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1200" y="1225" width="350" height="82" as="geometry"/></mxCell><mxCell id="p1_user_auth_b73" value="&lt;b&gt;Scenario: Visitor Opens /profile or Calls APIs While Logged Out&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1660" y="890" width="420" height="50" as="geometry"/></mxCell><mxCell id="p1_user_auth_b74" value="authService.&lt;br&gt;isLoggedIn()?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1805" y="970" width="130" height="70" as="geometry"/></mxCell><mxCell id="p1_user_auth_b75" value="&lt;b&gt;BLOCKED BY FRONTEND GUARD (UserProfilePage)&lt;/b&gt;&lt;br&gt;• Does NOT call &lt;code&gt;loadProfile(1)&lt;/code&gt;&lt;br&gt;• Redirects immediately to &lt;code&gt;/&lt;/code&gt;&lt;br&gt;• Calls &lt;code&gt;authService.openOtpModal('general')&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1630" y="1075" width="480" height="82" as="geometry"/></mxCell><mxCell id="p1_user_auth_b76" value="&lt;b&gt;BACKEND ENDPOINT GUARDS (When userId &amp;lt;= 0)&lt;/b&gt;&lt;br&gt;• &lt;code&gt;GET /api/auth/profile.php?userId=0&lt;/code&gt; → &lt;b&gt;HTTP 400&lt;/b&gt; &lt;i&gt;&quot;User ID is required&quot;&lt;/i&gt;&lt;br&gt;• &lt;code&gt;POST /api/properties/shortlist.php (userId=0)&lt;/code&gt; → &lt;b&gt;HTTP 401&lt;/b&gt; &lt;i&gt;&quot;Please sign in...&quot;&lt;/i&gt;&lt;br&gt;• &lt;code&gt;GET /api/properties/shortlist.php?userId=0&lt;/code&gt; → &lt;b&gt;HTTP 200&lt;/b&gt; &lt;code&gt;{ propertyIds: [], count: 0 }&lt;/code&gt;&lt;br&gt;• &lt;code&gt;GET /api/workspace/user-workspace.php?userId=0&lt;/code&gt; → Empty workspace&lt;br&gt;• &lt;code&gt;POST /api/auth/record-view.php (userId=0)&lt;/code&gt; → No DB insert" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1630" y="1185" width="480" height="122" as="geometry"/></mxCell><mxCell id="p1_user_auth_e77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b69" target="p1_user_auth_b70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b70" target="p1_user_auth_b71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b71" target="p1_user_auth_b72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b73" target="p1_user_auth_b74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e81" value="FALSE (Logged Out)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b74" target="p1_user_auth_b75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_user_auth_e82" value="If direct HTTP call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_user_auth_b75" target="p1_user_auth_b76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p2_admin_auth" name="2. Admin &amp; Staff Role Login Flow"><mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_admin_auth_b1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Flow 2: Admin, Builder &amp;amp; Internal Staff Role Authentication (POST /api/admin/login.php)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1300" height="35" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b2" value="&lt;b&gt;Color Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;■ Blue&lt;/font&gt;: Angular Component / Service &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7E22CE&quot;&gt;■ Purple&lt;/font&gt;: PHP REST Endpoint &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#D97706&quot;&gt;■ Amber Cylinder&lt;/font&gt;: MySQL Query / Table &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#CA8A04&quot;&gt;◆ Yellow Diamond&lt;/font&gt;: Decision / Validation&lt;br&gt;&lt;font color=&quot;#16A34A&quot;&gt;■ Green&lt;/font&gt;: &lt;b&gt;SUCCESS Case (200 OK / State Updated)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#DC2626&quot;&gt;■ Red&lt;/font&gt;: &lt;b&gt;FAILED / ERROR Case (400 / 401 / 402 / 403 / 404 / 422)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#EA580C&quot;&gt;■ Orange&lt;/font&gt;: Fallback / Guard Redirect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1080" height="52" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b3" value="&lt;b&gt;Staff / Admin User&lt;/b&gt;&lt;br&gt;Opens &lt;code&gt;/admin/login&lt;/code&gt; · Enters Username/Email &amp;amp; Password" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="700" y="125" width="340" height="52" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b4" value="&lt;b&gt;AdminLoginComponent → AdminService.login(email, password)&lt;/b&gt;&lt;br&gt;Sends &lt;code&gt;POST /api/admin/login.php&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="700" y="205" width="340" height="52" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b5" value="email or password&lt;br&gt;empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="285" width="140" height="70" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b6" value="&lt;b&gt;FAILED (HTTP 400)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Username/official email and password are required&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="360" height="58" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b7" value="&lt;b&gt;MySQL: Lookup Authorized Staff User&lt;/b&gt;&lt;br&gt;&lt;code&gt;SELECT * FROM users WHERE (LOWER(email)=:id OR LOWER(name)=:id)&lt;br&gt;AND role IN ('super_admin','admin','co_admin','developer','sales_executive',&lt;br&gt;'property_advisor','operations_executive','finance_admin','content_gis_admin')&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="660" y="385" width="420" height="82" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b8" value="Found in&lt;br&gt;users table?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="495" width="140" height="70" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b9" value="Matches known&lt;br&gt;$adminPersonas&lt;br&gt;alias?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="495" width="150" height="74" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b10" value="&lt;b&gt;FAILED (HTTP 401 Unauthorized)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Invalid credentials or unauthorized administrative access&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="502" width="280" height="60" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b11" value="Password in&lt;br&gt;persona.passwords?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="605" width="150" height="74" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b12" value="&lt;b&gt;FAILED (HTTP 401 Unauthorized)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Invalid administrative password for &amp;lt;Persona&amp;gt;&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="280" height="60" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b13" value="&lt;b&gt;Self-Healing DB Provisioning&lt;/b&gt;&lt;br&gt;Hashes password with &lt;code&gt;PASSWORD_BCRYPT&lt;/code&gt;&lt;br&gt;&lt;code&gt;INSERT INTO users ... ON DUPLICATE KEY UPDATE role, password_hash&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="315" y="715" width="280" height="72" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b14" value="Password valid?&lt;br&gt;(=='1111' OR bcrypt&lt;br&gt;OR persona pw)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="610" width="160" height="80" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b15" value="&lt;b&gt;FAILED (HTTP 401 Unauthorized)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Invalid administrative password for &amp;lt;Name&amp;gt;. Please check your credentials.&quot;&lt;/code&gt;&lt;br&gt;Frontend displays error alert on Admin Login screen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="618" width="400" height="64" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b16" value="&lt;b&gt;AUTHENTICATION SUCCESS (HTTP 200)&lt;/b&gt;&lt;br&gt;• Generates session token &lt;code&gt;adm_&amp;lt;random_hex&amp;gt;&lt;/code&gt;&lt;br&gt;• Saves session in &lt;code&gt;localStorage['findaplot_admin_session']&lt;/code&gt; &amp;amp; updates &lt;code&gt;authService.currentUser&lt;/code&gt;&lt;br&gt;• Resolves target portal route (&lt;code&gt;dashboardRoute&lt;/code&gt;) based on &lt;code&gt;admin.role&lt;/code&gt;:" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="830" width="460" height="86" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b17" value="Switch on&lt;br&gt;&lt;code&gt;admin.role&lt;/code&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="950" width="140" height="70" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b18" value="&lt;b&gt;super_admin / admin / co_admin&lt;/b&gt;&lt;br&gt;(Benny, Ezhil, Ram)&lt;br&gt;→ &lt;code&gt;/admin&lt;/code&gt; (Full Governance, Lead Command Center, Review Queue, Roles, Settings)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="290" height="90" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b19" value="&lt;b&gt;developer&lt;/b&gt;&lt;br&gt;(Builder Partner)&lt;br&gt;→ &lt;code&gt;/developer&lt;/code&gt; (Developer Portal: Post Projects, Link Inventory, Builder CRM)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="355" y="1080" width="270" height="90" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b20" value="&lt;b&gt;sales_executive&lt;/b&gt;&lt;br&gt;(Suresh)&lt;br&gt;→ &lt;code&gt;/portal/sales&lt;/code&gt; (Assigned Leads: Stages 1–3 Outreach &amp;amp; Requirements)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="650" y="1080" width="270" height="90" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b21" value="&lt;b&gt;property_advisor&lt;/b&gt;&lt;br&gt;(Dr. Ananya)&lt;br&gt;→ &lt;code&gt;/portal/advisor&lt;/code&gt; (Assigned Leads: Stages 4–5 Cadastral Advisory &amp;amp; Shortlist)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="945" y="1080" width="270" height="90" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b22" value="&lt;b&gt;operations_executive&lt;/b&gt;&lt;br&gt;(Karthik)&lt;br&gt;→ &lt;code&gt;/portal/operations&lt;/code&gt; (Stages 6–8 Site Visits, Gate Access &amp;amp; Token)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1240" y="1080" width="270" height="90" as="geometry"/></mxCell><mxCell id="p2_admin_auth_b23" value="&lt;b&gt;finance_admin / content_gis_admin&lt;/b&gt;&lt;br&gt;(Lakshmi / Venkatesh)&lt;br&gt;→ &lt;code&gt;/portal/finance&lt;/code&gt; or &lt;code&gt;/portal/gis&lt;/code&gt; (Ledger, Invoices, Refunds / GIS &amp;amp; Media)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1535" y="1080" width="310" height="90" as="geometry"/></mxCell><mxCell id="p2_admin_auth_e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;j