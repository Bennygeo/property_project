Limit Reached)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_view_quota_b17" target="p3_view_quota_b18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_view_quota_e35" value="YES (Quota Available)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_view_quota_b17" target="p3_view_quota_b19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_view_quota_e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_view_quota_b11" target="p3_view_quota_b19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_view_quota_e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_view_quota_b13" target="p3_view_quota_b19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1675" y="790"/><mxPoint x="1480" y="790"/><mxPoint x="1480" y="1140"/></Array></mxGeometry></mxCell><mxCell id="p3_view_quota_e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_view_quota_b16" target="p3_view_quota_b19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="905"/><mxPoint x="1490" y="905"/><mxPoint x="1490" y="1180"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p4_shortlist" name="4. Shortlist Add, Remove &amp; Sync Flow"><mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_shortlist_b1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Flow 4: Property Shortlist Add / Remove / Profile Sync (GET &amp;amp; POST /api/properties/shortlist.php)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1300" height="35" as="geometry"/></mxCell><mxCell id="p4_shortlist_b2" value="&lt;b&gt;Color Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;■ Blue&lt;/font&gt;: Angular Component / Service &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7E22CE&quot;&gt;■ Purple&lt;/font&gt;: PHP REST Endpoint &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#D97706&quot;&gt;■ Amber Cylinder&lt;/font&gt;: MySQL Query / Table &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#CA8A04&quot;&gt;◆ Yellow Diamond&lt;/font&gt;: Decision / Validation&lt;br&gt;&lt;font color=&quot;#16A34A&quot;&gt;■ Green&lt;/font&gt;: &lt;b&gt;SUCCESS Case (200 OK / State Updated)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#DC2626&quot;&gt;■ Red&lt;/font&gt;: &lt;b&gt;FAILED / ERROR Case (400 / 401 / 402 / 403 / 404 / 422)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#EA580C&quot;&gt;■ Orange&lt;/font&gt;: Fallback / Guard Redirect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1080" height="52" as="geometry"/></mxCell><mxCell id="p4_shortlist_b3" value="&lt;b&gt;User Clicks ♥ Heart Icon&lt;/b&gt;&lt;br&gt;(On PropertyCard, RecentSites, SearchPage, PropertyDetails, or UserProfilePage)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="125" width="420" height="54" as="geometry"/></mxCell><mxCell id="p4_shortlist_b4" value="&lt;b&gt;PropertyService.toggleShortlist(propertyId)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="700" y="205" width="300" height="44" as="geometry"/></mxCell><mxCell id="p4_shortlist_b5" value="authService.&lt;br&gt;isLoggedIn()?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="275" width="140" height="70" as="geometry"/></mxCell><mxCell id="p4_shortlist_b6" value="&lt;b&gt;BLOCKED BY FRONTEND GUARD (Unauthenticated Visitor)&lt;/b&gt;&lt;br&gt;• Shows warning toast: &lt;i&gt;&quot;Please sign in with your mobile number to shortlist properties.&quot;&lt;/i&gt;&lt;br&gt;• Calls &lt;code&gt;authService.openOtpModal('general')&lt;/code&gt;&lt;br&gt;• Does NOT mutate &lt;code&gt;shortlistedPropertyIds&lt;/code&gt; or call backend" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="180" y="270" width="480" height="86" as="geometry"/></mxCell><mxCell id="p4_shortlist_b7" value="&lt;b&gt;Optimistic UI &amp;amp; Mobile-Prefixed Storage Update&lt;/b&gt;&lt;br&gt;• Checks if &lt;code&gt;propertyId&lt;/code&gt; (case-insensitive) is in &lt;code&gt;shortlistedPropertyIds&lt;/code&gt;&lt;br&gt;• If adding: adds ID to Set + prepends dossier to &lt;code&gt;shortlistedProperties&lt;/code&gt;&lt;br&gt;• If removing: deletes ID from Set + filters out from &lt;code&gt;shortlistedProperties&lt;/code&gt; (and &lt;code&gt;profileData.shortlists&lt;/code&gt;)&lt;br&gt;• Saves to &lt;code&gt;localStorage['fap_&amp;lt;phone&amp;gt;_shortlists']&lt;/code&gt; &amp;amp; updates heart icon state immediately" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="600" y="375" width="500" height="100" as="geometry"/></mxCell><mxCell id="p4_shortlist_b8" value="&lt;b&gt;POST /api/properties/shortlist.php&lt;/b&gt;&lt;br&gt;Payload: &lt;code&gt;{ propertyId, action: 'add' | 'remove', userId }&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="660" y="505" width="380" height="52" as="geometry"/></mxCell><mxCell id="p4_shortlist_b9" value="resolveUserId(db)&lt;br&gt;userId &amp;gt; 0 in users?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="775" y="585" width="150" height="74" as="geometry"/></mxCell><mxCell id="p4_shortlist_b10" value="&lt;b&gt;FAILED (HTTP 401)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Please sign in to manage your shortlisted properties.&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="595" width="380" height="56" as="geometry"/></mxCell><mxCell id="p4_shortlist_b11" value="propertyId&lt;br&gt;non-empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="775" y="690" width="150" height="70" as="geometry"/></mxCell><mxCell id="p4_shortlist_b12" value="&lt;b&gt;FAILED (HTTP 400)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Property ID is required&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="697" width="380" height="56" as="geometry"/></mxCell><mxCell id="p4_shortlist_b13" value="&lt;b&gt;MySQL: Check Project Status&lt;/b&gt;&lt;br&gt;&lt;code&gt;SELECT project_id, status FROM projects WHERE UPPER(TRIM(project_id)) = UPPER(TRIM(?))&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="790" width="420" height="58" as="geometry"/></mxCell><mxCell id="p4_shortlist_b14" value="Is project&lt;br&gt;status == 'archived'?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="875" width="160" height="74" as="geometry"/></mxCell><mxCell id="p4_shortlist_b15" value="&lt;b&gt;FAILED (HTTP 404) – Archived Property Purge&lt;/b&gt;&lt;br&gt;• Backend runs &lt;code&gt;DELETE FROM user_shortlists WHERE property_id = ?&lt;/code&gt;&lt;br&gt;• Frontend &lt;code&gt;catchError(404)&lt;/code&gt; removes propertyId from &lt;code&gt;shortlistedPropertyIds&lt;/code&gt; &amp;amp; localStorage" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="160" y="872" width="490" height="80" as="geometry"/></mxCell><mxCell id="p4_shortlist_b16" value="Action is&lt;br&gt;'add' or 'remove'?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="980" width="160" height="74" as="geometry"/></mxCell><mxCell id="p4_shortlist_b17" value="&lt;b&gt;SUCCESS: ADDED (HTTP 200)&lt;/b&gt;&lt;br&gt;&lt;code&gt;INSERT INTO user_shortlists (user_id, property_id, created_at) VALUES (?, ?, NOW()) ON DUPLICATE KEY UPDATE&lt;/code&gt;&lt;br&gt;Returns &lt;code&gt;{ propertyId, isShortlisted: true, action: 'added' }&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="1090" width="460" height="82" as="geometry"/></mxCell><mxCell id="p4_shortlist_b18" value="&lt;b&gt;SUCCESS: REMOVED (HTTP 200)&lt;/b&gt;&lt;br&gt;&lt;code&gt;DELETE FROM user_shortlists WHERE user_id = ? AND UPPER(TRIM(property_id)) = UPPER(TRIM(?))&lt;/code&gt;&lt;br&gt;Returns &lt;code&gt;{ propertyId, isShortlisted: false, action: 'removed' }&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="1090" width="460" height="82" as="geometry"/></mxCell><mxCell id="p4_shortlist_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b3" target="p4_shortlist_b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b4" target="p4_shortlist_b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e21" value="FALSE (Guest)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b5" target="p4_shortlist_b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e22" value="TRUE (Logged In)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b5" target="p4_shortlist_b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b7" target="p4_shortlist_b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b8" target="p4_shortlist_b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e25" value="NO (userId &lt;= 0)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b9" target="p4_shortlist_b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e26" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b9" target="p4_shortlist_b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e27" value="NO (Empty)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b11" target="p4_shortlist_b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e28" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b11" target="p4_shortlist_b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b13" target="p4_shortlist_b14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e30" value="YES (Archived)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b14" target="p4_shortlist_b15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e31" value="NO (Active)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b14" target="p4_shortlist_b16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e32" value="action == 'add'" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b16" target="p4_shortlist_b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_shortlist_e33" value="action == 'remove'" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_shortlist_b16" target="p4_shortlist_b18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p5_subscriptions" name="5. Subscription Payment &amp; Refund Flow"><mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5_subscriptions_b1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Flow 5: Subscription Purchase (Razorpay HMAC Verification), Invoice Generation &amp;amp; Refund Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1400" height="35" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b2" value="&lt;b&gt;Color Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;■ Blue&lt;/font&gt;: Angular Component / Service &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7E22CE&quot;&gt;■ Purple&lt;/font&gt;: PHP REST Endpoint &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#D97706&quot;&gt;■ Amber Cylinder&lt;/font&gt;: MySQL Query / Table &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#CA8A04&quot;&gt;◆ Yellow Diamond&lt;/font&gt;: Decision / Validation&lt;br&gt;&lt;font color=&quot;#16A34A&quot;&gt;■ Green&lt;/font&gt;: &lt;b&gt;SUCCESS Case (200 OK / State Updated)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#DC2626&quot;&gt;■ Red&lt;/font&gt;: &lt;b&gt;FAILED / ERROR Case (400 / 401 / 402 / 403 / 404 / 422)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#EA580C&quot;&gt;■ Orange&lt;/font&gt;: Fallback / Guard Redirect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1080" height="52" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b3" value="5A. Plan Purchase &amp; Razorpay Signature Verification (create-order.php → verify-payment.php)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="1180" height="34" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b4" value="&lt;b&gt;Buyer Selects Tier on /subscription&lt;/b&gt;&lt;br&gt;(Smart Buyer ₹999 / Priority Buyer ₹2,499 / VIP Concierge ₹4,999)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="420" y="175" width="380" height="52" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b5" value="&lt;b&gt;POST /api/subscriptions/create-order.php&lt;/b&gt;&lt;br&gt;Checks active subscription in &lt;code&gt;user_subscriptions&lt;/code&gt; &amp;amp; creates Razorpay Order" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="400" y="255" width="420" height="54" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b6" value="Attempting&lt;br&gt;tier downgrade?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="335" width="150" height="72" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b7" value="&lt;b&gt;FAILED (HTTP 400) – Downgrade Blocked&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Downgrading from your active &amp;lt;Plan&amp;gt; tier is not permitted.&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="420" height="58" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b8" value="&lt;b&gt;Razorpay Checkout.js Modal (Browser)&lt;/b&gt;&lt;br&gt;User pays via UPI / Card / NetBanking against &lt;code&gt;order_id&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="435" width="400" height="54" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b9" value="Payment&lt;br&gt;completed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="515" width="150" height="70" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b10" value="&lt;b&gt;PAYMENT CANCELLED / FAILED IN RAZORPAY&lt;/b&gt;&lt;br&gt;Modal dismissed or bank declined · Subscription remains unchanged" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="522" width="420" height="56" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b11" value="&lt;b&gt;POST /api/subscriptions/verify-payment.php&lt;/b&gt;&lt;br&gt;Sends &lt;code&gt;{ razorpay_order_id, razorpay_payment_id, razorpay_signature, planId, userId }&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="380" y="615" width="460" height="56" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b12" value="HMAC-SHA256&lt;br&gt;signature valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="700" width="150" height="74" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b13" value="&lt;b&gt;FAILED (HTTP 403 Forbidden) – Tampering Detected&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Invalid Razorpay signature. Potential tampering detected — plan activation denied.&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="440" height="62" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b14" value="&lt;b&gt;MySQL Atomic Transaction (BEGIN ... COMMIT)&lt;/b&gt;&lt;br&gt;1. &lt;code&gt;UPDATE user_subscriptions SET status='upgraded' WHERE user_id=? AND status='active'&lt;/code&gt;&lt;br&gt;2. &lt;code&gt;INSERT INTO user_subscriptions&lt;/code&gt; (status=&lt;code&gt;'active'&lt;/code&gt;, starts_at=NOW(), expires_at=+duration_days)&lt;br&gt;3. &lt;code&gt;INSERT/UPDATE user_entitlements&lt;/code&gt; (resets used counters to 0, sets new plan limits)&lt;br&gt;4. &lt;code&gt;INSERT INTO subscription_invoices&lt;/code&gt; (generates GST Invoice &lt;code&gt;INV-YYYYMM-XXXX&lt;/code&gt; with 18% GST)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="350" y="805" width="520" height="110" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b15" value="&lt;b&gt;SUBSCRIPTION ACTIVATED (HTTP 200)&lt;/b&gt;&lt;br&gt;Returns active subscription, updated entitlements &amp;amp; downloadable GST Invoice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="390" y="950" width="440" height="64" as="geometry"/></mxCell><mxCell id="p5_subscriptions_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b4" target="p5_subscriptions_b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b5" target="p5_subscriptions_b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e18" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b6" target="p5_subscriptions_b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e19" value="NO (Order Created)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b6" target="p5_subscriptions_b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b8" target="p5_subscriptions_b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e21" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b9" target="p5_subscriptions_b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e22" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b9" target="p5_subscriptions_b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b11" target="p5_subscriptions_b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e24" value="NO (Invalid HMAC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b12" target="p5_subscriptions_b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e25" value="YES (Verified)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b12" target="p5_subscriptions_b14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b14" target="p5_subscriptions_b15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_b27" value="5B. Subscription Refund Flow (POST /api/subscriptions/refund.php)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1250" y="120" width="900" height="34" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b28" value="&lt;b&gt;User Requests Refund from Profile → Membership Tab&lt;/b&gt;&lt;br&gt;Submits &lt;code&gt;{ userId, invoiceId, reason }&lt;/code&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1500" y="175" width="400" height="52" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b29" value="&lt;b&gt;POST /api/subscriptions/refund.php&lt;/b&gt;&lt;br&gt;&lt;code&gt;SELECT * FROM subscription_invoices WHERE id=? AND user_id=? FOR UPDATE&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1480" y="255" width="440" height="56" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b30" value="Invoice exists&lt;br&gt;for user?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1625" y="340" width="150" height="70" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b31" value="&lt;b&gt;FAILED (HTTP 404)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Invoice not found or unauthorized&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1250" y="347" width="320" height="56" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b32" value="invoice.status ==&lt;br&gt;'refunded'?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1625" y="440" width="150" height="70" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b33" value="&lt;b&gt;FAILED (HTTP 400)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Invoice has already been refunded&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1250" y="447" width="320" height="56" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b34" value="&lt;b&gt;MySQL Atomic Refund Transaction&lt;/b&gt;&lt;br&gt;1. &lt;code&gt;INSERT INTO subscription_refunds&lt;/code&gt; (status='processed', razorpay_refund_id)&lt;br&gt;2. &lt;code&gt;UPDATE subscription_invoices SET status='refunded'&lt;/code&gt;&lt;br&gt;3. &lt;code&gt;UPDATE user_subscriptions SET status='cancelled'&lt;/code&gt;&lt;br&gt;4. &lt;code&gt;UPDATE user_entitlements SET plan_id='explorer', project_view_limit=2&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1460" y="545" width="480" height="100" as="geometry"/></mxCell><mxCell id="p5_subscriptions_b35" value="&lt;b&gt;REFUND PROCESSED (HTTP 200)&lt;/b&gt;&lt;br&gt;Plan reverted to Explorer tier · Invoice marked refunded" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1490" y="680" width="420" height="60" as="geometry"/></mxCell><mxCell id="p5_subscriptions_e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b28" target="p5_subscriptions_b29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b29" target="p5_subscriptions_b30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e38" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b30" target="p5_subscriptions_b31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e39" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b30" target="p5_subscriptions_b32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e40" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b32" target="p5_subscriptions_b33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e41" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b32" target="p5_subscriptions_b34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_subscriptions_e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_subscriptions_b34" target="p5_subscriptions_b35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p6_wallet_media" name="6. Media Points Unlock &amp; Wallet Recharge"><mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6_wallet_media_b1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Flow 6: 4K Walkthrough / Drone Media Unlock (media/unlock.php) &amp;amp; Wallet Recharge (wallet/recharge.php)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1400" height="35" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b2" value="&lt;b&gt;Color Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;■ Blue&lt;/font&gt;: Angular Component / Service &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7E22CE&quot;&gt;■ Purple&lt;/font&gt;: PHP REST Endpoint &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#D97706&quot;&gt;■ Amber Cylinder&lt;/font&gt;: MySQL Query / Table &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#CA8A04&quot;&gt;◆ Yellow Diamond&lt;/font&gt;: Decision / Validation&lt;br&gt;&lt;font color=&quot;#16A34A&quot;&gt;■ Green&lt;/font&gt;: &lt;b&gt;SUCCESS Case (200 OK / State Updated)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#DC2626&quot;&gt;■ Red&lt;/font&gt;: &lt;b&gt;FAILED / ERROR Case (400 / 401 / 402 / 403 / 404 / 422)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#EA580C&quot;&gt;■ Orange&lt;/font&gt;: Fallback / Guard Redirect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1080" height="52" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b3" value="6A. Unlock 4K Tour &amp; Drone Survey with Media Points (POST /api/media/unlock.php)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="1120" height="34" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b4" value="&lt;b&gt;User Clicks 'Unlock 4K Tour &amp;amp; Drone Survey'&lt;/b&gt;&lt;br&gt;Calls &lt;code&gt;propertyService.unlockMedia(propertyId)&lt;/code&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="420" y="175" width="360" height="52" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b5" value="&lt;b&gt;POST /api/media/unlock.php&lt;/b&gt; · Starts DB Transaction (&lt;code&gt;beginTransaction()&lt;/code&gt;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="400" y="255" width="400" height="48" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b6" value="Already in&lt;br&gt;&lt;code&gt;property_media_unlocks&lt;/code&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="160" height="74" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b7" value="&lt;b&gt;ALREADY UNLOCKED (HTTP 200)&lt;/b&gt;&lt;br&gt;Rolls back no-op tx · Returns &lt;code&gt;{ alreadyUnlocked: true }&lt;/code&gt; (0 points deducted)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="410" height="62" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b8" value="Property exists in&lt;br&gt;&lt;code&gt;properties&lt;/code&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="435" width="160" height="70" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b9" value="&lt;b&gt;FAILED (HTTP 404)&lt;/b&gt;&lt;br&gt;Rolls back · &lt;code&gt;&quot;Property not found&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="410" height="56" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b10" value="&lt;b&gt;MySQL Row Lock&lt;/b&gt;&lt;br&gt;&lt;code&gt;SELECT id, points_balance FROM users WHERE id = ? FOR UPDATE&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="410" y="535" width="380" height="56" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b11" value="points_balance &amp;gt;=&lt;br&gt;media_points?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="620" width="160" height="74" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b12" value="&lt;b&gt;FAILED (HTTP 402 Payment Required) – Insufficient Media Points&lt;/b&gt;&lt;br&gt;• Rolls back DB transaction&lt;br&gt;• Returns &lt;code&gt;{ currentBalance, required, shortfall }&lt;/code&gt;&lt;br&gt;• Frontend opens &lt;b&gt;TopupDialogComponent&lt;/b&gt; so user can recharge points" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="430" height="84" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b13" value="&lt;b&gt;MySQL Atomic Deduction &amp;amp; Unlock (COMMIT)&lt;/b&gt;&lt;br&gt;1. &lt;code&gt;UPDATE users SET points_balance = currentBalance - pointsRequired&lt;/code&gt;&lt;br&gt;2. &lt;code&gt;INSERT INTO property_media_unlocks (user_id, property_id, points_spent)&lt;/code&gt;&lt;br&gt;3. &lt;code&gt;INSERT INTO wallet_transactions ('debit_unlock', -pointsRequired, 'success')&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="360" y="730" width="480" height="90" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b14" value="&lt;b&gt;SUCCESS (HTTP 200) – 4K Media Unlocked!&lt;/b&gt;&lt;br&gt;Returns &lt;code&gt;{ isUnlocked: true, deducted, newBalance }&lt;/code&gt; · Updates WalletService balance signal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="370" y="855" width="460" height="64" as="geometry"/></mxCell><mxCell id="p6_wallet_media_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b4" target="p6_wallet_media_b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b5" target="p6_wallet_media_b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e17" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b6" target="p6_wallet_media_b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e18" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b6" target="p6_wallet_media_b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e19" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b8" target="p6_wallet_media_b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e20" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b8" target="p6_wallet_media_b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b10" target="p6_wallet_media_b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e22" value="NO (Shortfall)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b11" target="p6_wallet_media_b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e23" value="YES (Sufficient)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b11" target="p6_wallet_media_b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b13" target="p6_wallet_media_b14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_b25" value="6B. Wallet Points Recharge Flow (POST /api/wallet/recharge.php)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="900" height="34" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b26" value="&lt;b&gt;User Selects Recharge Pack in TopupDialog&lt;/b&gt;&lt;br&gt;Calls &lt;code&gt;walletService.rechargeWallet(points, bonus, amountRupees, method, userId)&lt;/code&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1430" y="175" width="440" height="56" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b27" value="&lt;b&gt;POST /api/wallet/recharge.php&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1500" y="260" width="300" height="46" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b28" value="userId &amp;gt; 0 and&lt;br&gt;totalPoints &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1575" y="335" width="150" height="72" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b29" value="&lt;b&gt;FAILED (HTTP 422)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Invalid user identifier or recharge points amount&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1200" y="342" width="330" height="56" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b30" value="&lt;b&gt;MySQL Lock User Row&lt;/b&gt;&lt;br&gt;&lt;code&gt;SELECT id, points_balance FROM users WHERE id = ? FOR UPDATE&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1460" y="435" width="380" height="56" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b31" value="User exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="520" width="140" height="68" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b32" value="&lt;b&gt;FAILED (HTTP 404)&lt;/b&gt;&lt;br&gt;Rolls back · &lt;code&gt;&quot;User account not found&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1200" y="526" width="330" height="56" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b33" value="&lt;b&gt;MySQL Atomic Credit Transaction (COMMIT)&lt;/b&gt;&lt;br&gt;1. &lt;code&gt;UPDATE users SET points_balance = currentBalance + points + bonus&lt;/code&gt;&lt;br&gt;2. &lt;code&gt;INSERT INTO wallet_transactions ('credit_purchase', +totalPoints, amountRupees, razorpay_payment_id, 'success')&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1420" y="620" width="460" height="82" as="geometry"/></mxCell><mxCell id="p6_wallet_media_b34" value="&lt;b&gt;WALLET CREDITED (HTTP 200)&lt;/b&gt;&lt;br&gt;Returns &lt;code&gt;{ transactionId, newBalance, totalPointsCredited }&lt;/code&gt; · Updates header points badge" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1430" y="735" width="440" height="64" as="geometry"/></mxCell><mxCell id="p6_wallet_media_e35" value="Opens TopupDialog" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b12" target="p6_wallet_media_b26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="720"/><mxPoint x="1170" y="720"/><mxPoint x="1170" y="203"/></Array></mxGeometry></mxCell><mxCell id="p6_wallet_media_e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b26" target="p6_wallet_media_b27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b27" target="p6_wallet_media_b28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e38" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b28" target="p6_wallet_media_b29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e39" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b28" target="p6_wallet_media_b30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b30" target="p6_wallet_media_b31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e41" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b31" target="p6_wallet_media_b32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e42" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b31" target="p6_wallet_media_b33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_wallet_media_e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6_wallet_media_b33" target="p6_wallet_media_b34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p7_prop_review" name="7. Property Submission &amp; Admin Review"><mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7_prop_review_b1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Flow 7: Property Listing Submission (create.php) &amp;amp; Four-Eyes Compliance Review (admin/review.php)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1400" height="35" as="geometry"/></mxCell><mxCell id="p7_prop_review_b2" value="&lt;b&gt;Color Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;■ Blue&lt;/font&gt;: Angular Component / Service &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7E22CE&quot;&gt;■ Purple&lt;/font&gt;: PHP REST Endpoint &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#D97706&quot;&gt;■ Amber Cylinder&lt;/font&gt;: MySQL Query / Table &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#CA8A04&quot;&gt;◆ Yellow Diamond&lt;/font&gt;: Decision / Validation&lt;br&gt;&lt;font color=&quot;#16A34A&quot;&gt;■ Green&lt;/font&gt;: &lt;b&gt;SUCCESS Case (200 OK / State Updated)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#DC2626&quot;&gt;■ Red&lt;/font&gt;: &lt;b&gt;FAILED / ERROR Case (400 / 401 / 402 / 403 / 404 / 422)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#EA580C&quot;&gt;■ Orange&lt;/font&gt;: Fallback / Guard Redirect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1080" height="52" as="geometry"/></mxCell><mxCell id="p7_prop_review_b3" value="&lt;b&gt;User / Builder / Admin Submits Property&lt;/b&gt;&lt;br&gt;Via &lt;code&gt;/post-property&lt;/code&gt;, Developer Portal, or Admin Dashboard (+ CSV Bulk Upload)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="125" width="440" height="54" as="geometry"/></mxCell><mxCell id="p7_prop_review_b4" value="&lt;b&gt;Media Upload: POST /api/properties/upload.php&lt;/b&gt;&lt;br&gt;Validates MIME type &amp;amp; size → Saves files to &lt;code&gt;backend/uploads/&lt;/code&gt; → Returns URLs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="680" y="205" width="440" height="54" as="geometry"/></mxCell><mxCell id="p7_prop_review_b5" value="&lt;b&gt;Create Listing: POST /api/properties/create.php&lt;/b&gt;&lt;br&gt;Sends property metadata + &lt;code&gt;masterDetails&lt;/code&gt; + uploaded media URLs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="680" y="285" width="440" height="54" as="geometry"/></mxCell><mxCell id="p7_prop_review_b6" value="title and price&lt;br&gt;provided?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="825" y="365" width="150" height="70" as="geometry"/></mxCell><mxCell id="p7_prop_review_b7" value="&lt;b&gt;FAILED (HTTP 400)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Property title / Price is mandatory&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="280" y="372" width="360" height="56" as="geometry"/></mxCell><mxCell id="p7_prop_review_b8" value="&lt;b&gt;MySQL: Insert Pending Property&lt;/b&gt;&lt;br&gt;• &lt;code&gt;INSERT INTO properties (id='prop-usr-...', status='pending_review', submitted_by_user_id)&lt;/code&gt;&lt;br&gt;• &lt;code&gt;PropertyMasterHelper::saveMasterDetails()&lt;/code&gt; → &lt;code&gt;property_master_details&lt;/code&gt;, &lt;code&gt;projects&lt;/code&gt;, &lt;code&gt;project_details&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="465" width="520" height="80" as="geometry"/></mxCell><mxCell id="p7_prop_review_b9" value="&lt;b&gt;Admin Compliance Queue (AdminDashboardComponent)&lt;/b&gt;&lt;br&gt;Reviewer selects listing and clicks Approve / Request Revision / Reject → &lt;code&gt;POST /api/admin/review.php&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="575" width="520" height="58" as="geometry"/></mxCell><mxCell id="p7_prop_review_b10" value="propertyId, reviewerId,&lt;br&gt;action present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="660" width="160" height="74" as="geometry"/></mxCell><mxCell id="p7_prop_review_b11" value="&lt;b&gt;FAILED (HTTP 400)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;propertyId, reviewerId, and action are mandatory&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="280" y="668" width="380" height="56" as="geometry"/></mxCell><mxCell id="p7_prop_review_b12" value="Maker-Checker:&lt;br&gt;submitted_by ==&lt;br&gt;reviewerId?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="765" width="160" height="78" as="geometry"/></mxCell><mxCell id="p7_prop_review_b13" value="&lt;b&gt;FAILED (HTTP 403 Forbidden) – Four-Eyes Violation&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Maker-Checker Violation: You cannot self-approve a property you submitted. A Co-Admin or Super Admin must review it.&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="770" width="480" height="68" as="geometry"/></mxCell><mxCell id="p7_prop_review_b14" value="Which review&lt;br&gt;action?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="880" width="160" height="74" as="geometry"/></mxCell><mxCell id="p7_prop_review_b15" value="&lt;b&gt;ACTION: APPROVE (status = 'published')&lt;/b&gt;&lt;br&gt;• &lt;code&gt;UPDATE projects &amp;amp; properties SET status='published', reviewed_by, reviewed_at=NOW()&lt;/code&gt;&lt;br&gt;• &lt;code&gt;INSERT INTO admin_activity_logs (action_type='approve_peer_review')&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Property immediately visible on public Search &amp;amp; Home pages&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="120" y="1000" width="460" height="96" as="geometry"/></mxCell><mxCell id="p7_prop_review_b16" value="&lt;b&gt;ACTION: REQUEST REVISION (status = 'revision_requested')&lt;/b&gt;&lt;br&gt;• &lt;code&gt;UPDATE projects &amp;amp; properties SET status='revision_requested', review_notes=:notes&lt;/code&gt;&lt;br&gt;• &lt;code&gt;INSERT INTO admin_activity_logs (action_type='request_revision')&lt;/code&gt;&lt;br&gt;• Submitter sees revision notes in Profile → My Properties" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="670" y="1000" width="460" height="96" as="geometry"/></mxCell><mxCell id="p7_prop_review_b17" value="&lt;b&gt;ACTION: REJECT (status = 'rejected')&lt;/b&gt;&lt;br&gt;• &lt;code&gt;UPDATE projects &amp;amp; properties SET status='rejected', rejection_reason=:reason&lt;/code&gt;&lt;br&gt;• &lt;code&gt;INSERT INTO admin_activity_logs (action_type='reject_property')&lt;/code&gt;&lt;br&gt;• Excluded from public catalog" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="1000" width="460" height="96" as="geometry"/></mxCell><mxCell id="p7_prop_review_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b3" target="p7_prop_review_b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b4" target="p7_prop_review_b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b5" target="p7_prop_review_b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e21" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b6" target="p7_prop_review_b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e22" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b6" target="p7_prop_review_b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b8" target="p7_prop_review_b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b9" target="p7_prop_review_b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e25" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b10" target="p7_prop_review_b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e26" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b10" target="p7_prop_review_b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e27" value="YES (Same Admin)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b12" target="p7_prop_review_b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e28" value="NO (Peer Reviewer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b12" target="p7_prop_review_b14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e29" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b14" target="p7_prop_review_b15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e30" value="request_revision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b14" target="p7_prop_review_b16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_prop_review_e31" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7_prop_review_b14" target="p7_prop_review_b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p8_lead_pipeline" name="8. Lead Pipeline, Assignment &amp; Halt Flow"><mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8_lead_pipeline_b1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Flow 8: Multi-Department Lead Pipeline, Role Assignment, Halted Lead Lock &amp;amp; Excel Export&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1450" height="35" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b2" value="&lt;b&gt;Color Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;■ Blue&lt;/font&gt;: Angular Component / Service &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7E22CE&quot;&gt;■ Purple&lt;/font&gt;: PHP REST Endpoint &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#D97706&quot;&gt;■ Amber Cylinder&lt;/font&gt;: MySQL Query / Table &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#CA8A04&quot;&gt;◆ Yellow Diamond&lt;/font&gt;: Decision / Validation&lt;br&gt;&lt;font color=&quot;#16A34A&quot;&gt;■ Green&lt;/font&gt;: &lt;b&gt;SUCCESS Case (200 OK / State Updated)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#DC2626&quot;&gt;■ Red&lt;/font&gt;: &lt;b&gt;FAILED / ERROR Case (400 / 401 / 402 / 403 / 404 / 422)&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#EA580C&quot;&gt;■ Orange&lt;/font&gt;: Fallback / Guard Redirect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1080" height="52" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b3" value="&lt;b&gt;Inbound Lead Capture&lt;/b&gt;&lt;br&gt;• Site Visit Booking: &lt;code&gt;POST /api/leads/book-visit.php&lt;/code&gt; → &lt;code&gt;inquiries_and_visits&lt;/code&gt;&lt;br&gt;• WhatsApp Inquiry / Webhook: &lt;code&gt;POST /api/webhooks/whatsapp.php&lt;/code&gt; → &lt;code&gt;whatsapp_chat_messages&lt;/code&gt; + AI Auto-Reply&lt;br&gt;• Registered Buyer Activity → Synced into &lt;code&gt;sales_lead_interactions&lt;/code&gt; (Stage 1: &lt;code&gt;new_enquiry&lt;/code&gt;)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="125" width="560" height="78" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b4" value="&lt;b&gt;Staff Opens Lead Pipeline / Role Portal&lt;/b&gt;&lt;br&gt;Calls &lt;code&gt;GET /api/admin/lead-pipeline.php?admin_id=&amp;lt;id&amp;gt;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#3B0764;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="680" y="230" width="440" height="52" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b5" value="User role in&lt;br&gt;$STAFF_ROLES?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="825" y="310" width="150" height="70" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b6" value="&lt;b&gt;FAILED (HTTP 403 Forbidden)&lt;/b&gt;&lt;br&gt;&lt;code&gt;&quot;Access denied. The Lead Pipeline is restricted to authorized internal staff only.&quot;&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="316" width="440" height="58" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b7" value="&lt;b&gt;Super Admin Manual Lead Assignment (AdminLeadsAssignmentComponent)&lt;/b&gt;&lt;br&gt;Admin assigns lead to specific staff members (`POST /api/admin/lead-pipeline.php` action=&lt;code&gt;assign_lead&lt;/code&gt;):&lt;br&gt;Updates &lt;code&gt;assigned_sales_id&lt;/code&gt;, &lt;code&gt;assigned_advisor_id&lt;/code&gt;, &lt;code&gt;assigned_ops_id&lt;/code&gt; in &lt;code&gt;sales_lead_interactions&lt;/code&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="410" width="560" height="74" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b8" value="Is lead status ==&lt;br&gt;'lost_on_hold'&lt;br&gt;(Discontinued / Halted)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="515" width="180" height="82" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b9" value="&lt;b&gt;HALTED / DISCONTINUED LEAD LOCK (Non-Admin Roles)&lt;/b&gt;&lt;br&gt;• Filtered OUT from Sales, Property Advisor, and Operations portals (&lt;b&gt;only Super Admin / Admin can view&lt;/b&gt;)&lt;br&gt;• Any attempt by staff to log stage updates or notes after &lt;code&gt;lost_on_hold&lt;/code&gt; is &lt;b&gt;REJECTED (HTTP 403/400)&lt;/b&gt;&lt;br&gt;  so no post-terminal logs can pollute the Cross-Department Audit Timeline" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="100" y="510" width="540" height="96" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b10" value="&lt;b&gt;Admin View of Halted Lead&lt;/b&gt;&lt;br&gt;Visible in Super Admin Command Center with terminal reason &amp;amp; full audit history (can only be reactivated by Admin)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1160" y="522" width="430" height="68" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b11" value="&lt;b&gt;1. Sales Executive Desk (Stages 1 → 3)&lt;/b&gt;&lt;br&gt;• Stage 1: &lt;code&gt;new_enquiry&lt;/code&gt;&lt;br&gt;• Stage 2: &lt;code&gt;customer_contacted&lt;/code&gt;&lt;br&gt;• Stage 3: &lt;code&gt;requirement_understood&lt;/code&gt; (captures budget, locality, intention) → Handover to Property Advisor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="635" width="560" height="82" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b12" value="&lt;b&gt;2. Property Advisor Desk (Stages 4 → 5)&lt;/b&gt;&lt;br&gt;• Stage 4: &lt;code&gt;projects_recommended&lt;/code&gt; (curated verified layouts &amp;amp; cadastral dossiers)&lt;br&gt;• Stage 5: &lt;code&gt;shortlist_completed&lt;/code&gt; (buyer confirms top 1–3 plots) → Handover to Operations Executive" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="745" width="560" height="76" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b13" value="&lt;b&gt;3. Operations Executive Desk (Stages 6 → 8)&lt;/b&gt;&lt;br&gt;• Stage 6: &lt;code&gt;site_visit_scheduled&lt;/code&gt; (coordinates gate access &amp;amp; vehicle)&lt;br&gt;• Stage 7: &lt;code&gt;site_visit_completed&lt;/code&gt;&lt;br&gt;• Stage 8: &lt;code&gt;negotiation_token&lt;/code&gt; (plot selected &amp;amp; token discussion started)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="850" width="560" height="82" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b14" value="Terminal&lt;br&gt;Outcome?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="825" y="965" width="150" height="74" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b15" value="&lt;b&gt;STAGE 9: DEAL CLOSED / BOOKED (WON)&lt;/b&gt;&lt;br&gt;• Updates &lt;code&gt;sales_lead_interactions&lt;/code&gt;: &lt;code&gt;status='deal_closed_booked'&lt;/code&gt;, &lt;code&gt;booked_property_id&lt;/code&gt;, &lt;code&gt;plot_no&lt;/code&gt;, &lt;code&gt;booking_amount&lt;/code&gt;, &lt;code&gt;final_price&lt;/code&gt;, &lt;code&gt;registration_date&lt;/code&gt;&lt;br&gt;• Appends immutable entry in &lt;code&gt;lead_stage_history&lt;/code&gt;&lt;br&gt;• Included in Super Admin Excel Pipeline Export (&lt;code&gt;.xlsx / .csv&lt;/code&gt;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="220" y="1080" width="540" height="100" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_b16" value="&lt;b&gt;STAGE 10: DISCONTINUED / HALTED (lost_on_hold)&lt;/b&gt;&lt;br&gt;• Can be triggered at ANY stage (1–8) when buyer drops out (e.g. Bank loan rejected, Budget mismatch)&lt;br&gt;• Updates &lt;code&gt;status='lost_on_hold'&lt;/code&gt;, &lt;code&gt;exit_stage&lt;/code&gt;, &lt;code&gt;exit_reason_category&lt;/code&gt;, &lt;code&gt;discontinued_at=NOW()&lt;/code&gt;&lt;br&gt;• Appends &lt;b&gt;TERMINAL&lt;/b&gt; entry in &lt;code&gt;lead_stage_history&lt;/code&gt; &amp;amp; locks lead from non-admin roles" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1020" y="1080" width="540" height="100" as="geometry"/></mxCell><mxCell id="p8_lead_pipeline_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p8_lead_pipeline_b3" target="p8_lead_pipeline_b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_lead_pipeline_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=au