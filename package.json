    "postinstall": "node -e \"const f='node_modules/@angular/cli/src/utilities/node-version.js'; const fs=require('fs'); if(fs.existsSync(f)){ let c=fs.readFileSync(f,'utf8'); if(c.includes('^22.22.3')){ fs.writeFileSync(f, c.replace('^22.22.3','^22.17.0')); } }\""
  },
